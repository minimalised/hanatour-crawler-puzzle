# [디벨롭 2] 네이버 SEO 사후 검증 함수 (품질 향상)
# -------------------------------------------------------------
def validate_naver_title(title):
    """네이버 쇼핑 상품명 가이드라인 만족 여부 검증"""
    if not title:
        return False
    # 1. 글자 수 검증 (공백 포함 25자 이상 ~ 35자 이하)
    if not (25 <= len(title) <= 35):
        return False
    # 2. 단어 중복 검증 (띄어쓰기 기준 동일 단어 2회 이상 등장 금지)
    words = title.split()
    if len(words) != len(set(words)):
        return False
    # 3. 금지 키워드 및 특수문자 검증
    forbidden = ["특가", "대박", "신상품", "세이브", "★", "▼", "▲", "◆"]
    if any(f_word in title for f_word in forbidden):
        return False
    return True

